@page "/tictac/{id:int}"
@inject IConfiguration Configuration
@using Npgsql
@using Dapper
@rendermode InteractiveServer

@message

Column Move:
<input label="Column Move" type='text' @bind="moveColumn" />

Row Move:
<input label="Row Move" type='text' @bind="moveRow" />

@if (string.IsNullOrEmpty(moveColumn) || string.IsNullOrEmpty(moveRow))
{
    <p>Please enter both row and column to make a move.</p>
}
else
{
    <button @onclick="MakeMove">Make Move</button>
}

Taken Moves:
<ul>
    @foreach (var move in moves)
    {
        <li>@move.horizontal, @move.vertical: @move.piece</li>
    }
</ul>

@code {
    [Parameter]
    public int id {get; set;}
    private string message = "";

    private string moveColumn ="";
    private string moveRow ="";

    private string characterTurn = "X";

    private int maxRow = 3;
    private int maxColumn = 3;

    private IEnumerable<dynamic> moves = Enumerable.Empty<dynamic>();

    protected override async Task OnInitializedAsync()
    {
        message = $"Game: {id}";
        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        var result = await conn.QueryAsync(
            "SELECT * FROM tictactoe WHERE game_id = @GameId",
            new { GameId = id });

        moves = result.ToList();

        if (!moves.Any())
        {
            message += " - Game Not Started";
        }
    }

    private async Task MakeMove()
    {
        message = "";
        
        if (!int.TryParse(moveRow, out var rowValue) || !int.TryParse(moveColumn, out var columnValue))
        {
            message = "Invalid Move: Row and column must be numeric.";
            return;
        }

        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        if (moves.Any(m => m.horizontal == rowValue && m.vertical == columnValue))
        {
            message = "Invalid Move: Cell already occupied";
            return;
        }

        if (rowValue <= 0 || rowValue > maxRow || columnValue <= 0 || columnValue > maxColumn)
        {
            message = "Invalid Move: Cell is out of bounds";
            return;
        }

        if (moves.Count() >= maxRow * maxColumn)
        {
            message = "Game Over: Board is full";
            return;
        }

        await conn.ExecuteAsync(@"
            INSERT INTO tictactoe (game_id, horizontal, vertical, piece) VALUES (@GameId, @Row, @Column, @Character)",
            new { GameId = id, Row = rowValue, Column = columnValue, Character = characterTurn });

        characterTurn = characterTurn == "X" ? "O" : "X";

        moveColumn = "";
        moveRow = "";

        var result = await conn.QueryAsync(
            "SELECT * FROM tictactoe WHERE game_id = @GameId",
            new { GameId = id });

        moves = result.ToList();

        if (moves.Any(m => m.piece == characterTurn && 
            ((moves.Count(mv => mv.horizontal == m.horizontal && mv.piece == characterTurn) == maxRow) ||
             (moves.Count(mv => mv.vertical == m.vertical && mv.piece == characterTurn) == maxColumn) ||
             (moves.Count(mv => mv.horizontal - mv.vertical == m.horizontal - m.vertical && mv.piece == characterTurn) == maxRow) ||
             (moves.Count(mv => mv.horizontal + mv.vertical == m.horizontal + m.vertical && mv.piece == characterTurn) == maxRow))))
        {
            message = $"Game Over: Player {characterTurn} wins!";
        }
    }

}