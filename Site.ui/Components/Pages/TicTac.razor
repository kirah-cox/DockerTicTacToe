@page "/tictac/{id:int}"
@inject IConfiguration Configuration
@using Npgsql
@using Dapper
@rendermode InteractiveServer

@message

<div style="display:grid; grid-template-columns: repeat(3, 60px); gap: 8px; margin: 1rem 0;">
    @for (var row = 1; row <= maxRow; row++)
    {
        @for (var column = 1; column <= maxColumn; column++)
        {
            var cellRow = row;
            var cellColumn = column;
            var cellValue = GetCellValue(cellRow, cellColumn);
            var isOccupied = !string.IsNullOrEmpty(cellValue);

            <button type="button"
                    @onclick="() => MakeMove(cellRow, cellColumn)"
                    disabled="@isOccupied"
                    style="width:60px; height:60px; font-size:2rem; font-weight:bold; border:1px solid #444; border-radius:8px; background:white; cursor:@(isOccupied ? "default" : "pointer");">
                @cellValue
            </button>
        }
    }
</div>

<p>Current turn: <strong>@characterTurn</strong></p>

Taken Moves:
<ul>
    @foreach (var move in moves)
    {
        <li>@move.horizontal, @move.vertical: @move.piece</li>
    }
</ul>

@code {
    [Parameter]
    public int id {get; set;}
    private string message = "";

    private string characterTurn = "X";

    private int maxRow = 3;
    private int maxColumn = 3;

    private IEnumerable<dynamic> moves = Enumerable.Empty<dynamic>();

    protected override async Task OnInitializedAsync()
    {
        message = $"Game: {id}";
        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        var result = await conn.QueryAsync(
            "SELECT * FROM tictactoe WHERE game_id = @GameId",
            new { GameId = id });

        moves = result.ToList();

        if (!moves.Any())
        {
            message += " - Game Not Started";
        }
    }

    private string GetCellValue(int row, int column)
    {
        var move = moves.FirstOrDefault(m => m.horizontal == row && m.vertical == column);
        return move is null ? string.Empty : move.piece?.ToString() ?? string.Empty;
    }

    private async Task MakeMove(int rowValue, int columnValue)
    {
        message = "";

        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        if (moves.Any(m => m.horizontal == rowValue && m.vertical == columnValue))
        {
            message = "Invalid Move: Cell already occupied";
            return;
        }

        if (rowValue <= 0 || rowValue > maxRow || columnValue <= 0 || columnValue > maxColumn)
        {
            message = "Invalid Move: Cell is out of bounds";
            return;
        }

        if (moves.Count() >= maxRow * maxColumn)
        {
            message = "Game Over: Board is full";
            return;
        }

        var currentPlayer = characterTurn;

        await conn.ExecuteAsync(@"
            INSERT INTO tictactoe (game_id, horizontal, vertical, piece) VALUES (@GameId, @Row, @Column, @Character)",
            new { GameId = id, Row = rowValue, Column = columnValue, Character = currentPlayer });

        var result = await conn.QueryAsync(
            "SELECT * FROM tictactoe WHERE game_id = @GameId",
            new { GameId = id });

        moves = result.ToList();

        if (HasPlayerWon(currentPlayer))
        {
            message = $"Game Over: Player {currentPlayer} wins!";
            return;
        }

        characterTurn = currentPlayer == "X" ? "O" : "X";
    }

    private bool HasPlayerWon(string player)
    {
        for (var row = 1; row <= maxRow; row++)
        {
            if (moves.Count(m => m.piece == player && m.horizontal == row) == maxRow)
            {
                return true;
            }
        }

        for (var column = 1; column <= maxColumn; column++)
        {
            if (moves.Count(m => m.piece == player && m.vertical == column) == maxColumn)
            {
                return true;
            }
        }

        if (Enumerable.Range(1, maxRow).Count(row =>
                moves.Any(m => m.piece == player && m.horizontal == row && m.vertical == row)) == maxRow)
        {
            return true;
        }

        if (Enumerable.Range(1, maxRow).Count(row =>
                moves.Any(m => m.piece == player && m.horizontal == row && m.vertical == (maxColumn - row + 1))) == maxRow)
        {
            return true;
        }

        return false;
    }

}